# Build wire from the repo root. Build context is `..` (the repo root)
# so the COPY can see go.mod / cmd / internal.
FROM golang:1.25-alpine AS builder

ARG VERSION=dev
ARG COMMIT=unknown
ARG BRANCH=unknown
ARG DATE=unknown

RUN apk add --no-cache gcc git make musl-dev pkgconf

WORKDIR /src
COPY . .

ENV CGO_ENABLED=1
RUN go build -o /out/wire \
    -ldflags="-w -s \
      -X github.com/tarungka/wire/internal/cmd.Version=${VERSION} \
      -X github.com/tarungka/wire/internal/cmd.Commit=${COMMIT} \
      -X github.com/tarungka/wire/internal/cmd.Branch=${BRANCH} \
      -X github.com/tarungka/wire/internal/cmd.Buildtime=${DATE}" \
    ./cmd/.

# Build the example worker so the stack is self-contained.
RUN go build -o /out/wire-worker-example ./examples/wire-worker-example/.

# Build the example submitter so the stack can drive load.
RUN go build -o /out/submit-uppercase-job ./examples/submit-uppercase-job/.

# Build the graph-bytes printer used by the k6 load service to seed the
# request body with a real (msgpack-encoded) JobGraph.
RUN go build -o /out/print-uppercase-graph ./examples/print-uppercase-graph/.

# CPU-intensive variant — paired with the cpu-burn map operator the
# wire-worker-example registers. Used by the k6-cpu profile for load
# tests that exercise real per-job latency, not just submit-path cost.
RUN go build -o /out/print-cpuburn-graph ./examples/print-cpuburn-graph/.

#######################################################################
FROM alpine:3.20

RUN apk add --no-cache ca-certificates curl
WORKDIR /app

COPY --from=builder /out/wire /usr/local/bin/wire
COPY --from=builder /out/wire-worker-example /usr/local/bin/wire-worker-example
COPY --from=builder /out/submit-uppercase-job /usr/local/bin/submit-uppercase-job
COPY --from=builder /out/print-uppercase-graph /usr/local/bin/print-uppercase-graph
COPY --from=builder /out/print-cpuburn-graph /usr/local/bin/print-cpuburn-graph

RUN mkdir -p /data
VOLUME /data

# Coordinator HTTP API, wire-protocol RPC, Prometheus /metrics scrape.
EXPOSE 4001 4002 9090

ENTRYPOINT ["/usr/local/bin/wire"]
